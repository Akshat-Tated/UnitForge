# ─────────────────────────────────────────────────────────────
# UnitForge Test Agent — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── LLM Provider ─────────────────────────────────────────────
# Options: stub | ollama | claude | openai | gemini
LLM_PROVIDER=stub

# ── Anthropic (claude) ───────────────────────────────────────
# ANTHROPIC_API_KEY=

# ── OpenAI (openai) ──────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Google Gemini (gemini) — FREE tier available ─────────────
# Get a free key at https://aistudio.google.com
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ── Ollama (ollama) — local, completely free ─────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:14b

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false

# ── Orchestrator ─────────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:8080
MAX_RETRY_ATTEMPTS=2

# ── Authentication ───────────────────────────────────────────
# Optional: JWT token for authenticating with the orchestrator
# Get this by logging in: POST /api/auth/login
# Leave empty for local development (dev mode bypasses auth)
AGENT_TOKEN=
